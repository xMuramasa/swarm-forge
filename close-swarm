#!/usr/bin/env zsh
set -euo pipefail

usage() {
  echo "Usage: close-swarm [project-root]" >&2
  echo "Stops the SwarmForge swarm for the given project (default: current directory)." >&2
  exit 1
}

if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
fi

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="$(cd "${1:-.}" && pwd)"

if [[ ! -d "$PROJECT_ROOT/.swarmforge" ]]; then
  echo "No SwarmForge swarm found at $PROJECT_ROOT (missing .swarmforge/)." >&2
  exit 1
fi

for candidate in "$SELF_DIR/swarmforge/scripts" "$SELF_DIR" "$PROJECT_ROOT/swarmforge/scripts"; do
  if [[ -f "$candidate/swarmforge.bb" ]]; then
    exec bb "$candidate/swarmforge.bb" --stop-project "$PROJECT_ROOT"
  fi
done

echo "Could not find swarmforge.bb relative to $SELF_DIR or $PROJECT_ROOT." >&2
exit 1
